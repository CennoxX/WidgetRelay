<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Invisible overlay window: widgets must be attached to a real window so
         their collection views (ListView etc.) load content at runtime -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The widget monitor keeps widgets hosted for the "Widget Updated" event -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <activity
            android:name=".tasker.widgets.ActivityConfigGetWidgetData"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/action_get_widget_data"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tasker.widgets.ActivityConfigClickWidget"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/action_click_widget_path"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tasker.widgets.ActivityConfigClickWidgetText"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/action_click_widget_text"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Settings actions: these control the widget monitor rather than
             reading a widget, so they use their own simple config screen -->
        <activity
            android:name=".tasker.widgets.ActivityConfigPauseWatching"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/action_pause_watching"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name=".tasker.widgets.ActivityConfigKeepCpuAwake"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/action_keep_cpu_awake"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <!-- Configured like the actions, but registered as an event: Tasker
             lists a condition plugin under Event only if its config activity
             handles ACTION_EDIT_EVENT. EDIT_CONDITION would make it a state. -->
        <activity
            android:name=".tasker.widgets.ActivityConfigWidgetUpdated"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/event_widget_updated"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="net.dinglisch.android.tasker.ACTION_EDIT_EVENT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.ActivityWidgetSelector"
            android:exported="false"
            android:label="@string/select_widget"
            android:theme="@style/AppTheme.NoActionBar" />

        <!-- The only screen of the app itself: what is currently being monitored -->
        <activity
            android:name=".widget.ActivityWidgetMonitor"
            android:exported="true"
            android:label="@string/monitor_title"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".widget.WidgetMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/monitor_fgs_explanation" />
        </service>

        <receiver
            android:name=".widget.WidgetMonitorWatchdog"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.cennoxx.widgetrelay.WATCHDOG" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
